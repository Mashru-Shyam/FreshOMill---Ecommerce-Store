{% if section.blocks.size > 0 %}
  <section class="fom-brand-story" aria-labelledby="fom-brand-story-title-{{ section.id }}">
    <div class="fom-brand-story__inner page-width">
      <div class="fom-brand-story__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="fom-brand-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 id="fom-brand-story-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <p class="fom-brand-story__description">{{ section.settings.description | escape }}</p>
        {% endif %}
      </div>

      <ul class="fom-brand-story__points" role="list">
        {% for block in section.blocks %}
          <li class="fom-brand-story__point" {{ block.shopify_attributes }}>
            <span class="fom-brand-story__icon" aria-hidden="true">
              <svg viewBox="0 0 32 32" focusable="false">
                <path d="M25.5 5.5C15 5.9 8.3 9.3 7 16.1c-.8 4.2 1.8 7.5 5.7 7.5 7.3 0 11.8-8 12.8-18.1Z" />
                <path d="M6 27c4.7-6.5 9.2-10.7 15-14" />
              </svg>
            </span>
            <span class="fom-brand-story__point-title">{{ block.settings.title | escape }}</span>
          </li>
        {% endfor %}
      </ul>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .fom-brand-story {
    padding-block: 40px;
    background: #fbfcf7;
  }

  .fom-brand-story__inner {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.8fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    width: min(100% - 48px, 1280px);
    margin-inline: auto;
    padding: clamp(24px, 4vw, 48px);
    border-radius: 20px;
    background: linear-gradient(115deg, #f2f7ed 0%, #fff 70%);
  }

  .fom-brand-story__eyebrow {
    margin: 0 0 8px;
    color: #216b3a;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .fom-brand-story__intro h2 {
    margin: 0;
    color: #12351f;
    font-size: clamp(1.6rem, 2.8vw, 2.25rem);
    line-height: 1.12;
  }

  .fom-brand-story__description {
    margin: 12px 0 0;
    color: #526057;
    line-height: 1.55;
  }

  .fom-brand-story__points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fom-brand-story__point {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-width: 0;
    min-height: 132px;
    padding: 12px 16px;
    color: #17251b;
    text-align: center;
  }

  .fom-brand-story__point + .fom-brand-story__point {
    border-inline-start: 1px solid rgb(33 107 58 / 16%);
  }

  .fom-brand-story__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #f2f7ed;
    color: #216b3a;
  }

  .fom-brand-story__icon svg {
    width: 27px;
    height: 27px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fom-brand-story__point-title {
    max-width: 16ch;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
    text-wrap: balance;
  }

  @media screen and (max-width: 749px) {
    .fom-brand-story {
      padding-block: 28px;
    }

    .fom-brand-story__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
      width: min(100% - 28px, 640px);
      padding: 22px 16px;
      border-radius: 16px;
    }

    .fom-brand-story__points {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .fom-brand-story__point {
      flex-direction: row;
      justify-content: flex-start;
      min-height: 0;
      padding: 10px 4px;
      text-align: start;
    }

    .fom-brand-story__point + .fom-brand-story__point {
      border-inline-start: 0;
      border-block-start: 1px solid rgb(33 107 58 / 16%);
    }

    .fom-brand-story__point-title {
      max-width: none;
      text-wrap: initial;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fresh O Mill brand values",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Fresh O Mill" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy your health" },
    { "type": "textarea", "id": "description", "label": "Description", "info": "Optional approved brand description." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Brand value",
      "settings": [
        { "type": "text", "id": "title", "label": "Text", "default": "Freshly Packed On Order" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Fresh O Mill brand values",
      "blocks": [
        { "type": "point", "settings": { "title": "Freshly Packed On Order" } },
        { "type": "point", "settings": { "title": "Premium Quality Ingredients" } },
        { "type": "point", "settings": { "title": "Sourced From Local Farms" } }
      ]
    }
  ]
}
{% endschema %}
