{% liquid
  assign section_heading = section.settings.heading | default: 'Shop by Category'
%}

<section class="fom-category-grid" aria-labelledby="fom-category-grid-heading-{{ section.id }}">
  <div class="fom-category-grid__inner page-width">
    {% if section_heading != blank %}
      <h2 class="fom-category-grid__heading" id="fom-category-grid-heading-{{ section.id }}">{{ section_heading | escape }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="fom-category-grid__subheading">{{ section.settings.subheading | escape }}</p>
    {% endif %}

    <ul class="fom-category-grid__items" role="list">
      {% for block in section.blocks %}
        {% assign category_title = block.settings.title %}
        {% assign category_param = category_title | url_encode %}
        {% assign category_collection = block.settings.collection %}
        {% if category_collection == blank %}
          {% assign category_handle = category_title | handleize %}
          {% assign category_collection = collections[category_handle] %}
        {% endif %}
        {% if category_collection != blank %}
          {% assign category_url = category_collection.url %}
          {% assign category_image = block.settings.image | default: category_collection.featured_image | default: category_collection.products.first.featured_image %}
        {% else %}
          {% assign category_url = routes.all_products_collection_url | append: '?filter.p.product_type=' | append: category_param %}
          {% assign category_image = block.settings.image %}
        {% endif %}
        <li class="fom-category-grid__item" {{ block.shopify_attributes }}>
          <a class="fom-category-grid__card" href="{{ category_url | escape }}" aria-label="Shop {{ category_title | escape }}">
            <span class="fom-category-grid__media">
              {% if category_image != blank %}
                {{ category_image | image_url: width: 900 | image_tag: class: 'fom-category-grid__image', widths: '240, 360, 540, 720, 900', sizes: '(min-width: 1200px) 220px, (min-width: 750px) 20vw, 46vw', loading: 'lazy', alt: '' }}
              {% else %}
                <span class="fom-category-grid__placeholder" aria-hidden="true"></span>
              {% endif %}
            </span>
            <span class="fom-category-grid__label">{{ category_title | escape }}</span>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
  .fom-category-grid {
    padding-block: 40px;
    background: #fbfcf7;
  }

  .fom-category-grid__inner {
    box-sizing: border-box;
    width: min(100% - 48px, 1280px);
    margin-inline: auto;
    padding: 24px;
    border-radius: 20px;
    background: #f2f7ed;
  }

  .fom-category-grid__heading {
    margin: 0;
    color: #12351f;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.15;
    text-align: start;
  }

  .fom-category-grid__subheading {
    margin: 8px 0 0;
    max-width: 50rem;
    color: #526455;
    text-align: start;
  }

  .fom-category-grid__items {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
  }

  .fom-category-grid__card {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 10px;
    overflow: hidden;
    height: 100%;
    padding: 8px;
    border: 1px solid rgb(23 37 27 / 7%);
    border-radius: 16px;
    background: #fff;
    color: #17251b;
    text-decoration: none;
  }

  .fom-category-grid__media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1.28 / 1;
    border-radius: 11px;
    background: #fbfcf7;
  }

  .fom-category-grid__image,
  .fom-category-grid__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .fom-category-grid__image {
    object-fit: cover;
    transition: transform 220ms ease;
  }

  .fom-category-grid__placeholder {
    background: linear-gradient(135deg, #f2f7ed 0%, #fbfcf7 52%, #e7ecdF 100%);
  }

  .fom-category-grid__label {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 2.5em;
    padding: 0 5px 3px;
    color: #17251b;
    font-size: clamp(0.85rem, 1.05vw, 1rem);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-wrap: balance;
  }

  .fom-category-grid__card:hover .fom-category-grid__image,
  .fom-category-grid__card:focus-visible .fom-category-grid__image {
    transform: scale(1.045);
  }

  .fom-category-grid__card:focus-visible {
    outline: 3px solid #ee9d1c;
    outline-offset: 3px;
  }

  @media screen and (max-width: 749px) {
    .fom-category-grid {
      padding-block: 32px;
    }

    .fom-category-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 22px;
    }

    .fom-category-grid__inner {
      width: min(100% - 28px, 640px);
      padding: 16px;
      border-radius: 16px;
    }

    .fom-category-grid__card {
      gap: 8px;
      padding: 6px;
      border-radius: 12px;
    }

    .fom-category-grid__media {
      aspect-ratio: 1.18 / 1;
      border-radius: 8px;
    }

    .fom-category-grid__label {
      min-height: 2.4em;
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fom-category-grid__image {
      transition: none;
    }
  }
{% endstylesheet %}

