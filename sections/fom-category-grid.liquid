{% liquid
  assign default_labels = 'Wood Pressed Oils|Flour & Multigrain|Dry Fruits & Dates|Nuts & Seeds|Millets|Spices|Masalas|Health Foods|Coffee & Tea|Pickles|Natural Sweetners|Pulses & Lentils|Fresh Nuts Butters|Pasta & Noodles|Poha|Quick Bites|Rava|Rice|Skin & Hair Care|Eco-Friendly' | split: '|'
  assign filter_parameter = section.settings.filter_parameter | default: 'filter.p.m.custom.category'
  assign view_all_url = section.settings.view_all_url | default: routes.all_products_collection_url
%}

<section class="fom-category-grid" aria-labelledby="fom-category-title-{{ section.id }}">
  <div class="fom-category-grid__inner page-width">
    <div class="fom-category-grid__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="fom-category-grid__eyebrow">
            <span aria-hidden="true">◆</span>
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}
        <h2 id="fom-category-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {% if section.settings.view_all_label != blank %}
        <a class="fom-category-grid__view-all" href="{{ view_all_url }}">
          <span>{{ section.settings.view_all_label | escape }}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      {% endif %}
    </div>

    <div class="fom-category-grid__cards">
      {% for default_label in default_labels %}
        {% liquid
          assign setting_number = forloop.index
          assign label_key = 'category_label_' | append: setting_number
          assign image_key = 'category_image_' | append: setting_number
          assign category_label = section.settings[label_key] | default: default_label
          assign category_image = section.settings[image_key]
          assign encoded_value = category_label | url_encode
          capture category_url
            echo routes.all_products_collection_url
            echo '?'
            echo filter_parameter
            echo '='
            echo encoded_value
          endcapture
        %}
        <a class="fom-category-card" href="{{ category_url | strip }}" aria-label="{{ 'fom_categories.shop_category' | t: category: category_label }}">
          <span class="fom-category-card__media">
            {% if category_image != blank %}
              {{ category_image
                | image_url: width: 720
                | image_tag:
                  class: 'fom-category-card__image',
                  widths: '240, 360, 480, 600, 720',
                  sizes: '(min-width: 990px) 18vw, (min-width: 750px) 31vw, 46vw',
                  loading: 'lazy',
                  alt: category_label
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'fom-category-card__placeholder' }}
            {% endif %}
          </span>
          <span class="fom-category-card__title">{{ category_label | escape }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .fom-category-grid {
    background: #fbfcf7;
    color: #17251b;
    padding-block: 26px 58px;
  }

  .fom-category-grid__inner {
    padding: 30px clamp(28px, 4vw, 68px) 34px;
    border: 1px solid #e6ecdf;
    border-radius: 18px;
    background: linear-gradient(135deg, #f7faef 0%, #fbfcf7 50%, #f2f7ed 100%);
  }

  .fom-category-grid__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-block-end: 24px;
  }

  .fom-category-grid__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 7px;
    color: #18572e;
    font-size: 14px;
    font-weight: 700;
  }

  .fom-category-grid__eyebrow span {
    color: #65a644;
    font-size: 11px;
    transform: rotate(45deg);
  }

  .fom-category-grid__header h2 {
    margin: 0;
    color: #12351f;
    font-size: clamp(30px, 3.2vw, 46px);
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  .fom-category-grid__view-all {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex: 0 0 auto;
    min-height: 44px;
    color: #18572e;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .fom-category-grid__view-all svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform 160ms ease;
  }

  .fom-category-grid__view-all:hover svg {
    transform: translateX(3px);
  }

  .fom-category-grid__view-all:focus-visible,
  .fom-category-card:focus-visible {
    outline: 3px solid #ee9d1c;
    outline-offset: 3px;
  }

  .fom-category-grid__cards {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 18px;
  }

  .fom-category-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e3e9e0;
    border-radius: 12px;
    background: #fff;
    color: #17251b;
    text-decoration: none;
    box-shadow: 0 3px 12px rgb(18 53 31 / .04);
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .fom-category-card:hover {
    border-color: #8fbd78;
    box-shadow: 0 8px 24px rgb(18 53 31 / .1);
    transform: translateY(-2px);
  }

  .fom-category-card__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1.18 / 1;
    overflow: hidden;
    background: #f2f7ed;
  }

  .fom-category-card__image,
  .fom-category-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .fom-category-card__placeholder {
    color: #d7e7ce;
  }

  .fom-category-card:hover .fom-category-card__image {
    transform: scale(1.035);
  }

  .fom-category-card__title {
    display: grid;
    place-items: center;
    min-height: 58px;
    padding: 10px 12px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.22;
    text-align: center;
  }

  @media screen and (max-width: 989px) {
    .fom-category-grid__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .fom-category-grid {
      padding-block: 18px 42px;
    }

    .fom-category-grid__inner {
      margin-inline: 14px;
      padding: 24px 14px 20px;
      border-radius: 14px;
    }

    .fom-category-grid__header {
      align-items: flex-start;
      margin-block-end: 20px;
    }

    .fom-category-grid__header h2 {
      font-size: clamp(28px, 8vw, 38px);
    }

    .fom-category-grid__view-all {
      margin-block-start: 23px;
    }

    .fom-category-grid__view-all span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .fom-category-grid__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .fom-category-card__title {
      min-height: 54px;
      padding: 9px 8px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fom-category-card,
    .fom-category-card__image,
    .fom-category-grid__view-all svg {
      transition: none;
    }

    .fom-category-card:hover,
    .fom-category-card:hover .fom-category-card__image,
    .fom-category-grid__view-all:hover svg {
      transform: none;
    }
  }
{% endstylesheet %}

