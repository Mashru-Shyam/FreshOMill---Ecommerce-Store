{{ 'fom-collection-v2.css' | asset_url | stylesheet_tag }}

<section class="fom-store" aria-labelledby="fom-store-title-{{ section.id }}">
  <div class="fom-store__hero">
    <div class="fom-store__hero-inner">
      <nav class="fom-store__breadcrumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span aria-hidden="true">›</span>
        <span>{{ collection.title | default: 'Products' }}</span>
      </nav>
      <h1 id="fom-store-title-{{ section.id }}">{{ collection.title | default: 'Our Store' }}</h1>
      <p class="fom-store__intro">
        {% if collection.description != blank %}
          {{ collection.description | strip_html | truncatewords: 28 }}
        {% else %}
          Freshly prepared staples and carefully selected pantry essentials, packed for your order.
        {% endif %}
      </p>
      <div class="fom-store__benefits">
        <span class="fom-store__benefit">Farm fresh</span>
        <span class="fom-store__benefit">Pure & natural</span>
        <span class="fom-store__benefit">Freshly packed</span>
        <span class="fom-store__benefit">Wholesome choices</span>
      </div>
    </div>
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
    <div class="fom-store__catalog">
      <aside class="fom-store__filters" aria-label="Product filters">
        <h2 class="fom-store__filter-title">Search products</h2>
        <form class="fom-store__search" action="{{ routes.search_url }}" method="get" role="search">
          <input type="hidden" name="type" value="product">
          <input type="search" name="q" placeholder="Search products" aria-label="Search products">
          <button type="submit" aria-label="Submit search">⌕</button>
        </form>
        {% render 'fom-collection-filters', collection: collection %}
      </aside>

      <div class="fom-store__results">
        <details class="fom-store__mobile-filter">
          <summary>Filter products</summary>
          <div class="fom-store__mobile-filter-body">
            {% render 'fom-collection-filters', collection: collection %}
          </div>
        </details>

        <div class="fom-store__toolbar">
          <p class="fom-store__result-count">{{ collection.products_count }} products</p>
          <form class="fom-store__sort" action="{{ collection.url }}" method="get">
            <label for="fom-sort-{{ section.id }}">Sort by</label>
            <select id="fom-sort-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
              {% assign current_sort = collection.sort_by | default: collection.default_sort_by %}
              {% for option in collection.sort_options %}
                <option value="{{ option.value }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name }}</option>
              {% endfor %}
            </select>
          </form>
        </div>

        {% if collection.products_count > 0 %}
          <div class="fom-store__grid">
            {% for product in collection.products %}
              {% render 'fom-unified-product-card', product: product %}
            {% endfor %}
          </div>
        {% else %}
          <div class="fom-store__empty">
            <h2>No products found</h2>
            <p>Try clearing the filters or choosing another category.</p>
            <a class="fom-store__clear" href="{{ collection.url }}">Clear filters</a>
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          <nav class="fom-store__pagination" aria-label="Pagination">
            {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Previous page">‹</a>{% endif %}
            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {% else %}
                <span{% if part.title == paginate.current_page %} class="current" aria-current="page"{% endif %}>{{ part.title }}</span>
              {% endif %}
            {% endfor %}
            {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Next page">›</a>{% endif %}
          </nav>
        {% endif %}
      </div>
    </div>
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Fresh O Mill catalogue",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Fresh O Mill catalogue"
    }
  ]
}
{% endschema %}
