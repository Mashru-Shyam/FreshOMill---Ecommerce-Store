<script src="{{ 'fom-customer-stories-v2.js' | asset_url }}" type="module" fetchpriority="low"></script>

<fom-stories class="fom-stories" aria-labelledby="fom-stories-title-{{ section.id }}">
  <div class="fom-stories__inner">
    <div class="fom-stories__header">
      <div>
        <p>Customer stories</p>
        <h2 id="fom-stories-title-{{ section.id }}">Healthier homes, happier kitchens</h2>
      </div>
      <div class="fom-stories__controls">
        <button type="button" data-story-previous aria-label="Previous customer story">‹</button>
        <button type="button" data-story-next aria-label="Next customer story">›</button>
      </div>
    </div>

    <div class="fom-stories__viewport">
      <div class="fom-stories__track" data-story-track>
        <article class="fom-stories__card">
          <span class="fom-stories__avatar" aria-hidden="true">{{ section.settings.name_1 | slice: 0 }}</span>
          <div><blockquote>“{{ section.settings.quote_1 }}”</blockquote><div class="fom-stories__stars" aria-label="5 out of 5 stars">★★★★★</div><strong data-story-name>{{ section.settings.name_1 }}</strong><small>{{ section.settings.location_1 }}</small></div>
        </article>
        <article class="fom-stories__card">
          <span class="fom-stories__avatar" aria-hidden="true">{{ section.settings.name_2 | slice: 0 }}</span>
          <div><blockquote>“{{ section.settings.quote_2 }}”</blockquote><div class="fom-stories__stars" aria-label="5 out of 5 stars">★★★★★</div><strong data-story-name>{{ section.settings.name_2 }}</strong><small>{{ section.settings.location_2 }}</small></div>
        </article>
        <article class="fom-stories__card">
          <span class="fom-stories__avatar" aria-hidden="true">{{ section.settings.name_3 | slice: 0 }}</span>
          <div><blockquote>“{{ section.settings.quote_3 }}”</blockquote><div class="fom-stories__stars" aria-label="5 out of 5 stars">★★★★★</div><strong data-story-name>{{ section.settings.name_3 }}</strong><small>{{ section.settings.location_3 }}</small></div>
        </article>
      </div>
    </div>
    <span class="visually-hidden" aria-live="polite" data-story-status></span>
  </div>
</fom-stories>

{% stylesheet %}
  .fom-stories {
    display: block;
    padding: 36px var(--fom-page-gutter, clamp(16px, 4vw, 64px));
    overflow: hidden;
    color: #07391e;
    background: linear-gradient(100deg, #f1f8e8, #fbf7e9);
  }

  .fom-stories__inner {
    width: min(100%, 1440px);
    margin-inline: auto;
  }

  .fom-stories__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 18px;
  }

  .fom-stories__header p {
    margin: 0 0 4px;
    color: #176b36;
    font-size: 12px;
    font-weight: 700;
  }

  .fom-stories__header h2 {
    margin: 0;
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .fom-stories__controls {
    display: flex;
    gap: 8px;
  }

  .fom-stories__controls button {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    padding: 0 0 3px;
    color: #176b36;
    font: inherit;
    font-size: 27px;
    line-height: 1;
    background: #fff;
    border: 1px solid #d5e0d2;
    border-radius: 50%;
    cursor: pointer;
  }

  .fom-stories__viewport {
    overflow: hidden;
  }

  .fom-stories__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .fom-stories__card {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 14px;
    min-width: 0;
    padding: 19px;
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(23, 107, 54, 0.1);
    border-radius: 11px;
  }

  .fom-stories__avatar {
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    color: #fff;
    font-size: 25px;
    font-weight: 800;
    background: #287c2f;
    border-radius: 50%;
  }

  .fom-stories blockquote {
    margin: 0 0 7px;
    color: #475149;
    font-size: 13px;
    line-height: 1.4;
  }

  .fom-stories__stars {
    margin-bottom: 5px;
    color: #f5a900;
    font-size: 13px;
    letter-spacing: 1px;
  }

  .fom-stories__card strong,
  .fom-stories__card small {
    display: block;
  }

  .fom-stories__card strong {
    font-size: 13px;
  }

  .fom-stories__card small {
    margin-top: 2px;
    color: #737c75;
    font-size: 11px;
  }

  @media screen and (max-width: 749px) {
    .fom-stories__track {
      display: flex;
    }

    .fom-stories__card {
      flex: 0 0 100%;
    }
  }

  @media screen and (max-width: 419px) {
    .fom-stories__card {
      grid-template-columns: 52px minmax(0, 1fr);
      padding: 15px;
    }

    .fom-stories__avatar {
      width: 52px;
      height: 52px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fresh O Mill stories",
  "settings": [
    {"type": "text", "id": "name_1", "label": "Customer 1", "default": "Priya S."},
    {"type": "text", "id": "location_1", "label": "Location 1", "default": "Vadodara"},
    {"type": "textarea", "id": "quote_1", "label": "Story 1", "default": "The staples taste fresh and natural. You can really feel the difference."},
    {"type": "text", "id": "name_2", "label": "Customer 2", "default": "Rahul M."},
    {"type": "text", "id": "location_2", "label": "Location 2", "default": "Ahmedabad"},
    {"type": "textarea", "id": "quote_2", "label": "Story 2", "default": "Pure ingredients and excellent quality. Now a regular part of our kitchen."},
    {"type": "text", "id": "name_3", "label": "Customer 3", "default": "Ananya K."},
    {"type": "text", "id": "location_3", "label": "Location 3", "default": "Surat"},
    {"type": "textarea", "id": "quote_3", "label": "Story 3", "default": "Everything arrives carefully packed and wonderfully fresh."}
  ],
  "presets": [{"name": "Fresh O Mill stories"}]
}
{% endschema %}
