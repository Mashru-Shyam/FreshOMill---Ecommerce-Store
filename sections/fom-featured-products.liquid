{% liquid
  assign featured_collection = section.settings.collection
  assign view_all_url = section.settings.view_all_url | default: featured_collection.url | default: routes.all_products_collection_url
%}

{% if featured_collection != blank or request.design_mode %}
  <script src="{{ 'product-form.js' | asset_url }}" type="module" fetchpriority="low"></script>

  <section class="fom-featured-products" aria-labelledby="fom-featured-title-{{ section.id }}">
    <div class="fom-featured-products__inner page-width">
      <div class="fom-featured-products__header">
        <div>
          {% if section.settings.eyebrow != blank %}
            <p class="fom-featured-products__eyebrow">
              <span aria-hidden="true">◆</span>
              {{ section.settings.eyebrow | escape }}
            </p>
          {% endif %}
          <h2 id="fom-featured-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
        {% if section.settings.view_all_label != blank %}
          <a class="fom-featured-products__view-all" href="{{ view_all_url }}">
            <span>{{ section.settings.view_all_label | escape }}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
        {% endif %}
      </div>

      {% if featured_collection != blank and featured_collection.products_count > 0 %}
        <div class="fom-featured-products__grid">
          {% for product in featured_collection.products limit: section.settings.products_to_show %}
            {% liquid
              assign selected_variant = product.selected_or_first_available_variant
              assign product_image_alt = product.featured_image.alt | default: product.title
            %}
            <article class="fom-product-card">
              <a class="fom-product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.featured_image != blank %}
                  {{ product.featured_image
                    | image_url: width: 720
                    | image_tag:
                      class: 'fom-product-card__image',
                      widths: '240, 360, 480, 600, 720',
                      sizes: '(min-width: 1200px) 15vw, (min-width: 750px) 31vw, 47vw',
                      loading: 'lazy',
                      alt: product_image_alt
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'fom-product-card__placeholder' }}
                {% endif %}
              </a>

              <div class="fom-product-card__content">
                <div class="fom-product-card__meta">
                  {% if product.type != blank %}
                    <span class="fom-product-card__type">{{ product.type | escape }}</span>
                  {% endif %}
                  <span class="fom-product-card__stock{% unless product.available %} fom-product-card__stock--sold-out{% endunless %}">
                    {% if product.available %}{{ 'fom_search.in_stock' | t }}{% else %}{{ 'fom_search.sold_out' | t }}{% endif %}
                  </span>
                </div>

                <h3 class="fom-product-card__title">
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </h3>

                {% if selected_variant != blank %}
                  <p class="fom-product-card__variant">
                    {% if selected_variant.title != 'Default Title' %}
                      {{ selected_variant.title | escape }}
                    {% elsif selected_variant.weight > 0 %}
                      {{ selected_variant.weight | weight_with_unit: selected_variant.weight_unit }}
                    {% endif %}
                  </p>
                {% endif %}

                <div class="fom-product-card__price">
                  <span>{{ product.price | money }}</span>
                  {% if product.compare_at_price_max > product.price %}
                    <s>{{ product.compare_at_price_max | money }}</s>
                  {% endif %}
                </div>

                <div class="fom-product-card__action">
                  {% if product.available and product.has_only_default_variant %}
                    {% assign product_form_id = 'FomFeaturedProductForm-' | append: section.id | append: '-' | append: product.id %}
                    <product-form-component
                      data-section-id="{{ section.id }}"
                      data-product-id="{{ product.id }}"
                      data-product-url="{{ product.url }}"
                      on:submit="/handleSubmit"
                    >
                      <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                      {% form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' %}
                        <input type="hidden" name="id" value="{{ selected_variant.id }}" ref="variantId">
                        <input type="hidden" name="quantity" value="1">
                        <button
                          class="fom-product-card__button"
                          type="submit"
                          name="add"
                          ref="addToCartButton"
                          on:click="/handleClick"
                        >
                          <span class="svg-wrapper" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
                          <span>{{ 'fom_products.add_to_cart' | t }}</span>
                        </button>
                      {% endform %}
                    </product-form-component>
                  {% elsif product.available %}
                    <a class="fom-product-card__button" href="{{ product.url }}">
                      <span>{{ 'fom_products.choose_options' | t }}</span>
                    </a>
                  {% else %}
                    <button class="fom-product-card__button" type="button" disabled>
                      <span>{{ 'fom_search.sold_out' | t }}</span>
                    </button>
                  {% endif %}
                </div>
              </div>
            </article>
          {% endfor %}
        </div>
      {% elsif request.design_mode %}
        <div class="fom-featured-products__empty">
          <p>{{ 'fom_products.select_collection' | t }}</p>
        </div>
      {% endif %}
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .fom-featured-products {
    background: #fbfcf7;
    color: #17251b;
    padding-block: 18px 66px;
  }

  .fom-featured-products__inner {
    padding-inline: clamp(28px, 4vw, 68px);
  }

  .fom-featured-products__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-block-end: 26px;
  }

  .fom-featured-products__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 7px;
    color: #18572e;
    font-size: 14px;
    font-weight: 700;
  }

  .fom-featured-products__eyebrow span {
    color: #65a644;
    font-size: 11px;
    transform: rotate(45deg);
  }

  .fom-featured-products__header h2 {
    margin: 0;
    color: #12351f;
    font-size: clamp(30px, 3.2vw, 46px);
    line-height: 1.08;
    letter-spacing: -.035em;
  }

  .fom-featured-products__view-all {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    flex: 0 0 auto;
    min-height: 44px;
    color: #18572e;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }

  .fom-featured-products__view-all svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    transition: transform 160ms ease;
  }

  .fom-featured-products__view-all:hover svg {
    transform: translateX(3px);
  }

  .fom-featured-products__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .fom-product-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e3e9e0;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 3px 14px rgb(18 53 31 / .04);
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .fom-product-card:hover {
    border-color: #a7c897;
    box-shadow: 0 9px 26px rgb(18 53 31 / .1);
    transform: translateY(-2px);
  }

  .fom-product-card__media {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #f6f8f2;
  }

  .fom-product-card__image,
  .fom-product-card__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 240ms ease;
  }

  .fom-product-card__placeholder {
    color: #d7e7ce;
  }

  .fom-product-card:hover .fom-product-card__image {
    transform: scale(1.025);
  }

  .fom-product-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 14px 12px 12px;
  }

  .fom-product-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 22px;
  }

  .fom-product-card__type {
    min-width: 0;
    overflow: hidden;
    color: #216b3a;
    font-size: 11px;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fom-product-card__stock {
    flex: 0 0 auto;
    padding: 4px 7px;
    border-radius: 999px;
    background: #e4f2dc;
    color: #18572e;
    font-size: 10px;
    font-weight: 700;
  }

  .fom-product-card__stock--sold-out {
    background: #f7e2e0;
    color: #9b2c2c;
  }

  .fom-product-card__title {
    margin: 10px 0 0;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .fom-product-card__title a {
    color: #17251b;
    text-decoration: none;
  }

  .fom-product-card__variant {
    min-height: 18px;
    margin: 4px 0 0;
    color: #748078;
    font-size: 12px;
  }

  .fom-product-card__price {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-block-start: 10px;
    color: #17251b;
    font-size: 18px;
    font-weight: 700;
  }

  .fom-product-card__price s {
    color: #748078;
    font-size: 12px;
    font-weight: 400;
  }

  .fom-product-card__action {
    margin-block-start: auto;
    padding-block-start: 14px;
  }

  .fom-product-card__action product-form-component,
  .fom-product-card__action form {
    display: block;
    width: 100%;
  }

  .fom-product-card__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    min-height: 42px;
    padding: 9px 10px;
    border: 1px solid #65a644;
    border-radius: 7px;
    background: #fff;
    color: #18572e;
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .fom-product-card__button .svg-wrapper,
  .fom-product-card__button svg {
    width: 18px;
    height: 18px;
  }

  .fom-product-card__button:hover:not(:disabled) {
    background: #216b3a;
    color: #fff;
  }

  .fom-product-card__button:disabled {
    border-color: #d8ddd6;
    background: #f1f2ef;
    color: #929992;
    cursor: not-allowed;
  }

  .fom-featured-products__view-all:focus-visible,
  .fom-product-card__media:focus-visible,
  .fom-product-card__title a:focus-visible,
  .fom-product-card__button:focus-visible {
    outline: 3px solid #ee9d1c;
    outline-offset: 3px;
  }

  .fom-featured-products__empty {
    display: grid;
    min-height: 180px;
    place-items: center;
    border: 1px dashed #a7c897;
    border-radius: 12px;
    background: #f2f7ed;
    color: #526057;
    text-align: center;
  }

  @media screen and (max-width: 1199px) {
    .fom-featured-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    .fom-featured-products {
      padding-block: 12px 48px;
    }

    .fom-featured-products__inner {
      padding-inline: 24px;
    }

    .fom-featured-products__header {
      align-items: flex-start;
      margin-block-end: 20px;
    }

    .fom-featured-products__header h2 {
      font-size: clamp(28px, 8vw, 38px);
    }

    .fom-featured-products__view-all {
      margin-block-start: 23px;
    }

    .fom-featured-products__view-all span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .fom-featured-products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .fom-product-card__content {
      padding: 11px 9px 10px;
    }

    .fom-product-card__meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 5px;
    }

    .fom-product-card__title {
      font-size: 14px;
    }

    .fom-product-card__price {
      font-size: 16px;
    }

    .fom-product-card__button {
      min-height: 44px;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fom-product-card,
    .fom-product-card__image,
    .fom-featured-products__view-all svg {
      transition: none;
    }

    .fom-product-card:hover,
    .fom-product-card:hover .fom-product-card__image,
    .fom-featured-products__view-all:hover svg {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Fresh O Mill products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Most loved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers this month" },
    { "type": "collection", "id": "collection", "label": "Product collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all products" },
    { "type": "url", "id": "view_all_url", "label": "View all link" }
  ],
  "presets": [
    { "name": "Fresh O Mill products" }
  ]
}
{% endschema %}
