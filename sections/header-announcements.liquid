{% capture announcements %}
  {% content_for 'blocks' %}
{% endcapture %}

{% assign announcements = announcements | replace: 'aria-hidden="true"', 'aria-hidden="false"' %}

<div
  class="fom-marquee"
  style="--fom-duration: {{ section.settings.duration }}s;"
  role="region"
  aria-label="{{ 'fom_header.announcements' | t }}"
>
  <div class="fom-marquee__viewport">
    <div class="fom-marquee__track">
      <div class="fom-marquee__group">
        {{ announcements }}
      </div>

      <div
        class="fom-marquee__group fom-marquee__copy"
        aria-hidden="true"
        inert
      >
        {{ announcements }}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .fom-marquee {
    position: relative;
    background: #18572e;
    color: #fff;
    padding: 8px 0;
  }

  .fom-marquee__viewport {
    overflow: hidden;
  }

  .fom-marquee__track {
    display: flex;
    width: max-content;
    animation: fom-announcement-scroll
      var(--fom-duration, 30s) linear infinite;
  }

  .fom-marquee__group {
    display: flex;
    align-items: center;
    justify-content: space-around;
    flex-shrink: 0;
    gap: 0;
    min-width: 100vw;
    padding-inline: 0;
    box-sizing: border-box;
  }

  .fom-marquee__group > .announcement-bar__slide {
    position: relative;
    display: block;
    flex: 0 0 auto;
    width: auto;
    max-width: none;
    opacity: 1;
    visibility: visible;
    transition: none;
    color: #fff;
    font-size: 12px;
    line-height: 1.4;
    text-align: left;
  }

  .fom-marquee__group > .announcement-bar__slide {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 0 auto;
    padding-inline-start: 24px;
  }

  .fom-marquee__group > .announcement-bar__slide::after {
    content: '•';
    display: inline-block;
    margin-inline-start: 24px;
    color: #ee9d1c;
    font-size: 10px;
    line-height: 1;
  }

  .fom-marquee .announcement-bar__text {
    margin: 0;
    color: #fff;
    white-space: nowrap;
  }

  .fom-marquee .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  .fom-marquee:hover .fom-marquee__track,
  .fom-marquee:focus-within .fom-marquee__track {
    animation-play-state: paused;
  }

  @keyframes fom-announcement-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fom-marquee {
      padding: 8px 16px;
    }

    .fom-marquee__copy {
      display: none;
    }

    .fom-marquee__track {
      animation: none;
      width: 100%;
    }

    .fom-marquee__group {
      min-width: 0;
      width: 100%;
      flex-wrap: wrap;
      gap: 8px 24px;
      padding: 0;
    }

    .fom-marquee .announcement-bar__text {
      white-space: normal;
    }
  }
  .fom-marquee .announcement-bar__slide,
  .fom-marquee .announcement-bar__text {
    font-size: 11px !important;
  }

  @media (max-width: 749px) {
    .fom-marquee__group > .announcement-bar__slide {
      padding-inline-start: 18px;
    }

    .fom-marquee__group > .announcement-bar__slide::after {
      margin-inline-start: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fom-marquee__group {
      min-width: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 5,
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "duration",
      "label": "t:settings.scroll_speed",
      "min": 15,
      "max": 60,
      "step": 1,
      "unit": "sec",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement",
          "settings": {
            "text": "Freshly Packed On Order"
          }
        },
        "announcement_2": {
          "type": "_announcement",
          "settings": {
            "text": "Premium Quality Ingredients"
          }
        },
        "announcement_3": {
          "type": "_announcement",
          "settings": {
            "text": "Sourced From Local Farms"
          }
        },
        "announcement_4": {
          "type": "_announcement",
          "settings": {
            "text": "Washed & Cleaned"
          }
        },
        "announcement_5": {
          "type": "_announcement",
          "settings": {
            "text": "No Preservatives Or Adulterants"
          }
        }
      },
      "block_order": [
        "announcement_1",
        "announcement_2",
        "announcement_3",
        "announcement_4",
        "announcement_5"
      ]
    }
  ]
}
{% endschema %}
