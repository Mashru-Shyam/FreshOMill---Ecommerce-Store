<div class="fom-field">
  <label for="{{ prefix }}-first-name">First name</label>
  <input id="{{ prefix }}-first-name" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
</div>
<div class="fom-field">
  <label for="{{ prefix }}-last-name">Last name</label>
  <input id="{{ prefix }}-last-name" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
</div>
<div class="fom-field">
  <label for="{{ prefix }}-company">Company</label>
  <input id="{{ prefix }}-company" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization">
</div>
<div class="fom-field">
  <label for="{{ prefix }}-address1">Address</label>
  <input id="{{ prefix }}-address1" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1" required>
</div>
<div class="fom-field">
  <label for="{{ prefix }}-address2">Apartment, suite, etc.</label>
  <input id="{{ prefix }}-address2" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2">
</div>
<div class="fom-field">
  <label for="{{ prefix }}-city">City</label>
  <input id="{{ prefix }}-city" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2" required>
</div>
<div class="fom-field">
  <label for="{{ prefix }}-country">Country/region</label>
  <select id="{{ prefix }}-country" name="address[country]" data-default="{{ form.country }}" autocomplete="country">{{ all_country_option_tags }}</select>
</div>
<div class="fom-field">
  <label for="{{ prefix }}-province">State/province</label>
  <input id="{{ prefix }}-province" type="text" name="address[province]" value="{{ form.province }}" autocomplete="address-level1">
</div>
<div class="fom-field">
  <label for="{{ prefix }}-zip">Postal code</label>
  <input id="{{ prefix }}-zip" type="text" name="address[zip]" value="{{ form.zip }}" autocapitalize="characters" autocomplete="postal-code" required>
</div>
<div class="fom-field">
  <label for="{{ prefix }}-phone">Phone</label>
  <input id="{{ prefix }}-phone" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel">
</div>
<label class="fom-field--checkbox">
  {{ form.set_as_default_checkbox }}
  <span>Set as default address</span>
</label>
