<form class="fom-store__filter-form" action="{{ collection.url }}" method="get">
  {% if collection.sort_by != blank %}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{% endif %}

  <div class="fom-store__filter-group">
    <h3>Categories</h3>
    <div class="fom-store__categories">
      <a class="fom-store__category{% if collection.handle == 'all' %} is-active{% endif %}" href="{{ routes.all_products_collection_url }}">
        <span>All categories</span>
        <span class="fom-store__count">{{ collections.all.products_count }}</span>
      </a>
      {% for category_collection in collections limit: 8 %}
        {% unless category_collection.handle == 'all' or category_collection.products_count == 0 %}
          <a class="fom-store__category{% if category_collection.handle == collection.handle %} is-active{% endif %}" href="{{ category_collection.url }}">
            <span>{{ category_collection.title }}</span>
            <span class="fom-store__count">{{ category_collection.products_count }}</span>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  </div>

  {% for filter in collection.filters %}
    <div class="fom-store__filter-group">
      <h3>{{ filter.label }}</h3>
      {% case filter.type %}
        {% when 'boolean', 'list' %}
          <div class="fom-store__values">
            {% for value in filter.values %}
              <label class="fom-store__value">
                <input
                  type="checkbox"
                  name="{{ value.param_name }}"
                  value="{{ value.value }}"
                  {% if value.active %}checked{% endif %}
                  {% if value.count == 0 and value.active == false %}disabled{% endif %}
                >
                <span>{{ value.label }}</span>
                <span class="fom-store__count">{{ value.count }}</span>
              </label>
            {% endfor %}
          </div>
        {% when 'price_range' %}
          <div class="fom-store__price-inputs">
            <label>
              Min
              <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" min="0" placeholder="0">
            </label>
            <label>
              Max
              <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" min="0" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
            </label>
          </div>
      {% endcase %}
    </div>
  {% endfor %}

  <div class="fom-store__filter-actions">
    <button class="fom-store__apply" type="submit">Apply filters</button>
    <a class="fom-store__clear" href="{{ collection.url }}">Clear filters</a>
  </div>
</form>
