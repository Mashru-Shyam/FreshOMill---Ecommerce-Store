{% liquid
  assign card_product = product
  assign card_variant = card_product.selected_or_first_available_variant
  assign card_type = card_product.type
  if card_type == blank and card_product.collections.first != blank
    assign card_type = card_product.collections.first.title
  endif
  assign card_variant_text = blank
  unless card_product.has_only_default_variant
    assign card_variant_text = card_variant.title
  else
    if card_variant.weight > 0
      assign card_variant_text = card_variant.weight | weight_with_unit: card_variant.weight_unit
    endif
  endunless
  assign card_form_id = 'FomProductCardForm-' | append: section.id | append: '-' | append: card_product.id
%}

<article class="fom-product-card">
  <a class="fom-product-card__media" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
    {% if card_product.featured_image != blank %}
      {{ card_product.featured_image | image_url: width: 720 | image_tag: class: 'fom-product-card__image', loading: 'lazy', widths: '240, 360, 480, 600, 720', sizes: '(min-width: 1200px) 16vw, (min-width: 750px) 30vw, 48vw', alt: card_product.featured_image.alt | default: card_product.title }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'fom-product-card__placeholder' }}
    {% endif %}
    {% if card_product.compare_at_price_max > card_product.price %}<span class="fom-product-card__badge">Sale</span>{% endif %}
  </a>

  <div class="fom-product-card__body">
    <div class="fom-product-card__meta">
      {% if card_type != blank %}<span class="fom-product-card__type">{{ card_type | escape }}</span>{% endif %}
      <span class="fom-product-card__stock{% unless card_product.available %} is-sold-out{% endunless %}">{% if card_product.available %}In stock{% else %}Sold out{% endif %}</span>
    </div>
    <h3 class="fom-product-card__title"><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
    <p class="fom-product-card__variant">{{ card_variant_text | escape }}</p>
    <div class="fom-product-card__price">
      <strong>{{ card_product.price | money }}</strong>
      {% if card_product.compare_at_price_max > card_product.price %}<s>{{ card_product.compare_at_price_max | money }}</s>{% endif %}
    </div>
    <div class="fom-product-card__action">
      {% if card_product.available and card_product.has_only_default_variant %}
        <product-form-component data-section-id="{{ section.id }}" data-product-id="{{ card_product.id }}" data-product-url="{{ card_product.url }}" on:submit="/handleSubmit">
          <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
          {% form 'product', card_product, id: card_form_id, data-type: 'add-to-cart-form' %}
            <input type="hidden" name="id" value="{{ card_variant.id }}" ref="variantId">
            <input type="hidden" name="quantity" value="1">
            <button class="fom-product-card__button" type="submit" name="add" ref="addToCartButton" on:click="/handleClick">
              <span class="svg-wrapper" aria-hidden="true">{{ 'icon-cart.svg' | inline_asset_content }}</span>
              <span>Add to cart</span>
            </button>
          {% endform %}
        </product-form-component>
      {% elsif card_product.available %}
        <a class="fom-product-card__button" href="{{ card_product.url }}">Choose options</a>
      {% else %}
        <button class="fom-product-card__button" type="button" disabled>Out of stock</button>
      {% endif %}
    </div>
  </div>
</article>
