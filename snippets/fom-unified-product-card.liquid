{% liquid
  assign card_variant = product.selected_or_first_available_variant
  assign card_image = product.featured_media.preview_image | default: product.featured_image
  assign card_type = product.type | default: product.vendor
  assign card_weight = card_variant.weight | weight_with_unit: card_variant.weight_unit
  assign product_form_id = 'fom-card-form-' | append: section.id | append: '-' | append: product.id
%}

<article class="fom-product-card">
  <a class="fom-product-card__media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
    {% if card_image != blank %}
      {{ card_image
        | image_url: width: 720
        | image_tag:
          loading: 'lazy',
          widths: '220, 320, 440, 560, 720',
          sizes: '(max-width: 749px) 46vw, (max-width: 1199px) 30vw, 16vw',
          alt: product.title,
          class: 'fom-product-card__image'
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag: 'fom-product-card__placeholder' }}
    {% endif %}
  </a>

  <div class="fom-product-card__content">
    <div class="fom-product-card__meta">
      {% if card_type != blank %}
        <span class="fom-product-card__category">{{ card_type }}</span>
      {% endif %}
      <span class="fom-product-card__stock{% unless product.available %} is-unavailable{% endunless %}">
        {% if product.available %}In stock{% else %}Out of stock{% endif %}
      </span>
    </div>

    <h3 class="fom-product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {% if card_weight != blank or card_variant.title != 'Default Title' %}
      <p class="fom-product-card__variant">
        {% if card_weight != blank %}
          {{ card_weight }}
        {% else %}
          {{ card_variant.title }}
        {% endif %}
      </p>
    {% endif %}

    <div class="fom-product-card__purchase">
      <div class="fom-product-card__price-row">
        <span class="fom-product-card__price">{{ card_variant.price | money }}</span>
        {% if card_variant.compare_at_price > card_variant.price %}
          <s class="fom-product-card__compare-price">{{ card_variant.compare_at_price | money }}</s>
        {% endif %}
      </div>

      {% if product.available and product.has_only_default_variant %}
        <product-form-component data-section-id="{{ section.id }}">
          {% form 'product', product, id: product_form_id, class: 'fom-product-card__form' %}
            <input type="hidden" name="id" value="{{ card_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="fom-product-card__button" type="submit" name="add">
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                <path d="M3 4h2l2 11h10l2-8H7M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM17 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span>Add to cart</span>
            </button>
          {% endform %}
        </product-form-component>
      {% elsif product.available %}
        <a class="fom-product-card__button" href="{{ product.url }}">Choose options</a>
      {% else %}
        <button class="fom-product-card__button" type="button" disabled>Out of stock</button>
      {% endif %}
    </div>
  </div>
</article>
