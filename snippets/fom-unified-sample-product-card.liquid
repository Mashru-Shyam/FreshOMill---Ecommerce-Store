{% liquid
  assign sample_index = index | default: 1
  assign sample_category = 'Flours & Atta'
  assign sample_title = 'Whole Wheat Flour'
  assign sample_weight = '1 kg'
  assign sample_price = '₹249'
  assign placeholder_index = sample_index | minus: 1 | modulo: 6 | plus: 1
  assign placeholder_name = 'product-' | append: placeholder_index

  case sample_index
    when 2
      assign sample_category = 'Pulses & Lentils'
      assign sample_title = 'Organic Toor Dal'
      assign sample_weight = '1 kg'
      assign sample_price = '₹169'
    when 3
      assign sample_category = 'Oils & Ghee'
      assign sample_title = 'Cold-Pressed Groundnut Oil'
      assign sample_weight = '1 L'
      assign sample_price = '₹349'
    when 4
      assign sample_category = 'Rice & Grains'
      assign sample_title = 'Organic Basmati Rice'
      assign sample_weight = '1 kg'
      assign sample_price = '₹219'
    when 5
      assign sample_category = 'Spices & Masala'
      assign sample_title = 'Turmeric Powder'
      assign sample_weight = '200 g'
      assign sample_price = '₹149'
    when 6
      assign sample_category = 'Spices & Masala'
      assign sample_title = 'Black Pepper Whole'
      assign sample_weight = '100 g'
      assign sample_price = '₹189'
    when 7
      assign sample_category = 'Flours & Atta'
      assign sample_title = 'Jowar Flour'
      assign sample_weight = '1 kg'
      assign sample_price = '₹89'
    when 8
      assign sample_category = 'Flours & Atta'
      assign sample_title = 'Bajra Flour'
      assign sample_weight = '1 kg'
      assign sample_price = '₹79'
    when 9
      assign sample_category = 'Spices & Masala'
      assign sample_title = 'Red Chilli Powder'
      assign sample_weight = '200 g'
      assign sample_price = '₹89'
    when 10
      assign sample_category = 'Spices & Masala'
      assign sample_title = 'Coriander Powder'
      assign sample_weight = '200 g'
      assign sample_price = '₹79'
    when 11
      assign sample_category = 'Pulses & Lentils'
      assign sample_title = 'Besan Flour'
      assign sample_weight = '500 g'
      assign sample_price = '₹99'
    when 12
      assign sample_category = 'Rice & Grains'
      assign sample_title = 'Basmati Rice'
      assign sample_weight = '1 kg'
      assign sample_price = '₹199'
  endcase
%}

<article class="fom-product-card fom-product-card--sample">
  <div class="fom-product-card__media" aria-hidden="true">
    {{ placeholder_name | placeholder_svg_tag: 'fom-product-card__placeholder' }}
  </div>
  <div class="fom-product-card__content">
    <div class="fom-product-card__meta">
      <span class="fom-product-card__category">{{ sample_category }}</span>
      <span class="fom-product-card__stock">In stock</span>
    </div>
    <h3 class="fom-product-card__title">{{ sample_title }}</h3>
    <p class="fom-product-card__variant">{{ sample_weight }}</p>
    <div class="fom-product-card__purchase">
      <div class="fom-product-card__price-row">
        <span class="fom-product-card__price">{{ sample_price }}</span>
      </div>
      <button class="fom-product-card__button" type="button" disabled>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M3 4h2l2 11h10l2-8H7M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2ZM17 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span>Preview product</span>
      </button>
    </div>
  </div>
</article>
